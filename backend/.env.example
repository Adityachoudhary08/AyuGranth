# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Gemini API key (for cloud LLM mode)
GEMINI_API_KEY=your-gemini-api-key-here

# Ollama base URL (for local/privacy LLM mode)
OLLAMA_BASE_URL=http://localhost:11434

# JWT authentication
JWT_SECRET=change-me-to-a-strong-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bhashini API credentials (multilingual voice/translation)
# BHASHINI_USER_ID: your user-id from bhashini.gov.in registration
BHASHINI_USER_ID=your-bhashini-user-id
# BHASHINI_API_KEY: ulcaApiKey (from your Bhashini ULCA registration)
BHASHINI_API_KEY=your-bhashini-ulca-api-key
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Embedding model (sentence-transformers model ID)
EMBEDDING_MODEL=BAAI/bge-m3

# LLM mode & provider: LLM_PROVIDER="gemini" or "ollama" / LLM_MODE="cloud" or "local"
LLM_PROVIDER=gemini
LLM_MODE=cloud